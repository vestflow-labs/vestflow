# VestFlow Indexer — environment variables
# Copy to .env and fill in values before running.

# Network this poller process indexes: testnet or mainnet
INDEXER_NETWORK=testnet

# Stellar RPC endpoints
RPC_URL_TESTNET=https://soroban-testnet.stellar.org
RPC_URL_MAINNET=https://mainnet.sorobanrpc.com

# VestFlow Soroban contract addresses
CONTRACT_ID_TESTNET=CCZ6AE75C27DMB3SOIHK7WZSBUG3NQPVLHSVEBQ2FSAEVGRJ5TXAZWCX
CONTRACT_ID_MAINNET=

# Absolute paths to the SQLite database files
# Defaults to vestflow-events-testnet.db and vestflow-events-mainnet.db
INDEXER_DB_PATH_TESTNET=./vestflow-events-testnet.db
INDEXER_DB_PATH_MAINNET=./vestflow-events-mainnet.db

# PostgreSQL connection pool (defaults: min 0, max 20, idle timeout 30000 ms)
DB_POOL_MIN=0
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Bearer token required for GET /metrics
METRICS_TOKEN=

# Optional shared Redis URL for cross-process balance-cache invalidation
REDIS_URL=

# Polling interval in milliseconds (default: 10 seconds)
POLL_INTERVAL_MS=10000

# TVL aggregation interval in milliseconds (default: 60 seconds)
TVL_COMPUTE_INTERVAL_MS=60000

# Ledger to start from on first run (0 = latest ledger from RPC)
# Set to a specific ledger number to replay history from that point.
START_LEDGER=0

# Port for the query HTTP server
INDEXER_PORT=3001

# ── Webhooks ──────────────────────────────────────────────────────────
# 32-byte hex key encrypting webhook signing secrets at rest.
# Required to enable webhooks; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates existing registrations.
WEBHOOK_ENCRYPTION_KEY=

# Must match the app's JWT_SECRET — the webhook management API authenticates
# the wallet JWTs minted by POST /api/auth/verify.
JWT_SECRET=

# Concurrent delivery requests (default 10)
WEBHOOK_CONCURRENCY=10

# Delivery queue poll interval in milliseconds (default 1000)
WEBHOOK_POLL_INTERVAL_MS=1000

# Seconds before a delivery stranded in_flight by a crash is reclaimed
WEBHOOK_LEASE_SECONDS=120

# Set to false to queue deliveries without sending them
WEBHOOK_DELIVERY_ENABLED=true

# Local development only: allows http:// and private/loopback endpoints
WEBHOOK_ALLOW_INSECURE_URLS=false
