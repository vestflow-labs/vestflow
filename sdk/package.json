{
  "name": "@drips/stellar-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for interacting with the Drips/VestFlow streaming and vesting contracts on Stellar/Soroban.",
  "license": "MIT",
  "author": "VestFlow Labs",
  "homepage": "https://github.com/vestflow-labs/vestflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/vestflow-labs/vestflow.git",
    "directory": "sdk"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup --config tsup.esm.config.ts && tsup --config tsup.cjs.config.ts && node scripts/finalize-dist.mjs",
    "dev": "tsup --config tsup.esm.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "peerDependencies": {
    "@stellar/freighter-api": "^6.0.1"
  },
  "peerDependenciesMeta": {
    "@stellar/freighter-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "drips",
    "vesting",
    "streaming",
    "blockchain",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
