# ─────────────────────────────────────────────────
#  VestFlow — environment configuration
#  Copy this file to .env.local and fill in values.
# ─────────────────────────────────────────────────

# ── Testnet (default) ─────────────────────────────
# Deployed testnet contract: CCZ6AE75C27DMB3SOIHK7WZSBUG3NQPVLHSVEBQ2FSAEVGRJ5TXAZWCX
NEXT_PUBLIC_CONTRACT_ID=

# Native XLM token address on Stellar testnet.
# Serves as the default token pre-filled in the UI, but any SEP-41 compliant token address is supported.
NEXT_PUBLIC_NATIVE_TOKEN=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Network: "testnet" or "mainnet" (default: testnet)
NEXT_PUBLIC_NETWORK=testnet

# ── Mainnet (uncomment when deploying to mainnet) ──
# Replace the values below with real mainnet addresses
# after completing the mainnet deployment checklist (see README).
#
# NEXT_PUBLIC_NETWORK=mainnet
# NEXT_PUBLIC_CONTRACT_ID=<your-mainnet-contract-id>
# NEXT_PUBLIC_NATIVE_TOKEN=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA

# ── Notifications (optional) ──────────────────────
# SendGrid API key for email notifications
SENDGRID_API_KEY=

# Email address notifications will be sent from
NOTIFICATION_FROM_EMAIL=noreply@vestflow.xyz

# Base URL for notification links (default: https://vestflow.xyz)
NEXT_PUBLIC_BASE_URL=https://vestflow.xyz

# Indexer query server the browser connects to for the real-time notification
# SSE stream (default: http://localhost:3001). Set this to the deployed
# indexer URL in production.
# NEXT_PUBLIC_INDEXER_URL=http://localhost:3001

# ── Caching (optional) ─────────────────────────────
# Redis connection string for the read-through cache on contract-state API
# routes (schedule reads, claimable amounts). If unset, those routes read
# directly from Horizon/RPC on every request — no functional difference,
# just no caching.
REDIS_URL=

# ── Indexer — gap detection and replay ────────────
#
# These variables are read by the indexer poller process (indexer/src/poller.ts)
# and are NOT exposed to the browser.
#
# --- Feature flags ---
# Set to "false" to disable startup + periodic gap detection entirely.
# Useful when the indexer is intentionally paused or replaying manually.
ENABLE_GAP_DETECTION=true

# Set to "false" to disable the background replay worker.
# Gap detection will still enqueue ranges; the worker just won't drain them.
ENABLE_REPLAY_ENGINE=true

# --- Timing ---
# How often the periodic gap check runs (milliseconds, default 5 minutes).
GAP_DETECTION_INTERVAL_MS=300000

# How often the indexer polls the Stellar RPC for new events (default 10 s).
POLL_INTERVAL_MS=10000

# --- Horizon archive endpoints ---
# Override the Horizon base URL used for gap detection and archive replay.
# The defaults below point to the public Stellar Foundation endpoints.
HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org
HORIZON_URL_MAINNET=https://horizon.stellar.org

# --- Replay engine tuning ---
# Number of events fetched per RPC batch during replay (default 200, max 200).
REPLAY_BATCH_SIZE=200

# Maximum number of retry attempts per replay range before it is marked failed
# and an alert is emitted to the log (default 8 → delays: 1s 2s 4s 8s 16s 32s 64s 64s).
REPLAY_MAX_RETRIES=8

# Base delay in milliseconds for the exponential backoff on retries (default 1000).
REPLAY_RETRY_DELAY_MS=1000

# Update the replay_queue.completed_ledger progress column every N ledgers so
# a restart resumes mid-range rather than from the beginning (default 100).
REPLAY_PROGRESS_INTERVAL=100

# --- Database paths (indexer process) ---
# Absolute path to the SQLite database for the indexer.
# If unset, defaults to vestflow-events-<network>.db in the process cwd.
# INDEXER_DB_PATH=/var/data/vestflow-events.db
# INDEXER_DB_PATH_TESTNET=/var/data/vestflow-events-testnet.db
# INDEXER_DB_PATH_MAINNET=/var/data/vestflow-events-mainnet.db
